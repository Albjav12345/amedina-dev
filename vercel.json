
{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "trailingSlash": false,
    "functions": {
        "api/cv-admin.js": {
            "includeFiles": "{src/data/cv/published.json,public/assets/alberto.webp}"
        }
    },
    "headers": [
        {
            "source": "/Alberto_Medina_CV_2026.pdf",
            "headers": [
                { "key": "Cache-Control", "value": "no-store, max-age=0" }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/",
            "has": [
                {
                    "type": "host",
                    "value": "datacraft.amedina.dev"
                }
            ],
            "destination": "https://assetstore.unity.com/packages/tools/datacraft-visual-json-tools-7396611",
            "permanent": false
        }
    ],
    "rewrites": [
        { "source": "/about", "destination": "/" },
        { "source": "/projects", "destination": "/" },
        { "source": "/stack", "destination": "/" },
        { "source": "/architect", "destination": "/" },
        { "source": "/contact", "destination": "/" },
        { "source": "/cv-studio", "destination": "/" }
    ]
}
